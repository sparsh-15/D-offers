# Server
PORT=3000
# MONGODB_URI=mongodb+srv://abhishekdubey8274:abhishekdubey8274@cluster0.tr8ehid.mongodb.net/d-offers?appName=Cluster0

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/MyOffers

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d

# OTP
MASTER_OTP=999999
OTP_EXPIRY_MINUTES=10
SEND_OTP_VIA_SMS=false

# SMS (when SEND_OTP_VIA_SMS=true)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: disable dev/last-otp endpoint when not in production
NODE_ENV=development

# Admin seed (run: npm run seed:admin)
ADMIN_SEED_ENABLED=true
ADMIN_ROLE=super_admin
ADMIN_NAME=Admin
ADMIN_PHONE=9999999999
ADMIN_PINCODE=110001
ADMIN_ADDRESS=

# Gemini (Google Generative AI) – used for in-app assistant
# Get a key from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
