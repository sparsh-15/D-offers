generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleEnum {
  super_admin
  subadmin
  company_sales_agent
  ssa
  shopkeeper
  customer

  @@map("role_enum")
}

enum ApprovalStatusEnum {
  pending
  approved
  rejected

  @@map("approval_status_enum")
}

enum OfferStatusEnum {
  active
  inactive
  expired

  @@map("offer_status_enum")
}

enum DiscountTypeEnum {
  percentage
  fixed

  @@map("discount_type_enum")
}

enum SubscriptionStatusEnum {
  active
  inactive
  expired
  cancelled
  pending

  @@map("subscription_status_enum")
}

enum PaymentStatusEnum {
  pending
  paid
  failed
  refunded

  @@map("payment_status_enum")
}

enum PaymentMethodEnum {
  cash
  upi
  card
  netbanking
  other

  @@map("payment_method_enum")
}

enum AuditActionEnum {
  user_activated
  user_deactivated
  user_approved
  user_rejected
  subscription_created
  subscription_updated
  subscription_cancelled
  subscription_renewed
  subscription_plan_created
  subscription_plan_updated
  subscription_plan_deleted
  shop_approved
  shop_rejected
  coupon_activated
  agent_assigned

  @@map("audit_action_enum")
}

model User {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name           String             @default("")
  email          String?
  phone          String             @unique
  password       String?
  role           RoleEnum
  pincode        String             @default("")
  city           String             @default("")
  state          String             @default("")
  region         String             @default("")
  territory      String             @default("")
  address        String             @default("")
  approvalStatus ApprovalStatusEnum @default(approved) @map("approval_status")
  permissions    String[]           @default([])
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeperProfile      ShopkeeperProfile?
  onboardedShops         ShopkeeperProfile[]            @relation("OnboardedBy")
  offers                 Offer[]                        @relation("OfferShopkeeper")
  offerLikes             OfferLike[]
  subscriptions          Subscription[]                 @relation("SubscriptionShopkeeper")
  cancelledSubscriptions Subscription[]                 @relation("CancelledBy")
  agentCoupons           Coupon[]                       @relation("CouponAgent")
  onboardingStatus       OnboardingStatus?
  adminAuditLogs         AuditLog[]                     @relation("AuditAdmin")
  targetAuditLogs        AuditLog[]                     @relation("AuditTarget")
  planPriceChanges       SubscriptionPlanPriceHistory[] @relation("PriceChangedBy")

  @@index([role, approvalStatus, createdAt(sort: Desc)], map: "idx_users_role_approval_created_desc")
  @@index([role, isActive, createdAt(sort: Desc)], map: "idx_users_role_active_created_desc")
  @@index([pincode], map: "idx_users_pincode")
  @@index([city], map: "idx_users_city")
  @@index([state], map: "idx_users_state")
  @@map("users")
}

model ShopkeeperProfile {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  shopName    String   @map("shop_name")
  address     String?
  pincode     String?
  city        String?
  category    String?
  description String?
  onboardedBy String?  @map("onboarded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User  @relation(fields: [userId], references: [id])
  onboardedByUser User? @relation("OnboardedBy", fields: [onboardedBy], references: [id])

  @@index([category], map: "idx_shopkeeper_profiles_category")
  @@index([onboardedBy], map: "idx_shopkeeper_profiles_onboarded_by")
  @@index([pincode], map: "idx_shopkeeper_profiles_pincode")
  @@index([city], map: "idx_shopkeeper_profiles_city")
  @@map("shopkeeper_profiles")
}

model Offer {
  id                 String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shopkeeperId       String           @map("shopkeeper_id") @db.Uuid
  title              String
  description        String?
  photos             String[]         @default([])
  termsAndConditions String?          @map("terms_and_conditions")
  category           String?
  discountType       DiscountTypeEnum @default(percentage) @map("discount_type")
  discountValue      Decimal?         @map("discount_value") @db.Decimal(12, 2)
  validFrom          DateTime?        @map("valid_from") @db.Timestamptz(6)
  validTo            DateTime?        @map("valid_to") @db.Timestamptz(6)
  status             OfferStatusEnum  @default(active)
  likesCount         Int              @default(0) @map("likes_count")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeper User        @relation("OfferShopkeeper", fields: [shopkeeperId], references: [id])
  likes      OfferLike[]

  @@index([shopkeeperId, createdAt(sort: Desc)], map: "idx_offers_shopkeeper_created_desc")
  @@index([status, createdAt(sort: Desc)], map: "idx_offers_status_created_desc")
  @@index([validTo], map: "idx_offers_valid_to")
  @@index([category, createdAt(sort: Desc)], map: "idx_offers_category_created_desc")
  @@map("offers")
}

model OfferLike {
  offerId   String   @map("offer_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([offerId, userId])
  @@index([userId, createdAt(sort: Desc)], map: "idx_offer_likes_user_created_desc")
  @@index([offerId], map: "idx_offer_likes_offer")
  @@map("offer_likes")
}

model SubscriptionPlan {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name              String   @unique
  displayName       String   @map("display_name")
  description       String   @default("")
  monthlyPrice      Decimal  @map("monthly_price") @db.Decimal(12, 2)
  durationDays      Int      @default(30) @map("duration_days")
  category          String
  features          String[] @default([])
  maxOffers         Int      @default(-1) @map("max_offers")
  maxPhotosPerOffer Int      @default(5) @map("max_photos_per_offer")
  analyticsEnabled  Boolean  @default(false) @map("analytics_enabled")
  prioritySupport   Boolean  @default(false) @map("priority_support")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]
  priceHistory  SubscriptionPlanPriceHistory[]

  @@index([isActive, category, sortOrder, monthlyPrice], map: "idx_subscription_plans_active_category_sort_price")
  @@index([category, isActive], map: "idx_subscription_plans_category_active")
  @@map("subscription_plans")
}

model SubscriptionPlanPriceHistory {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  price     Decimal  @db.Decimal(12, 2)
  changedBy String?  @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  reason    String?

  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  changedByUser User?            @relation("PriceChangedBy", fields: [changedBy], references: [id])

  @@index([planId, changedAt(sort: Desc)], map: "idx_plan_price_history_plan_changed_desc")
  @@map("subscription_plan_price_history")
}

model Subscription {
  id                 String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shopkeeperId       String                 @map("shopkeeper_id") @db.Uuid
  planId             String                 @map("plan_id") @db.Uuid
  planSnapshot       Json                   @map("plan_snapshot")
  status             SubscriptionStatusEnum @default(pending)
  startDate          DateTime?              @map("start_date") @db.Timestamptz(6)
  endDate            DateTime?              @map("end_date") @db.Timestamptz(6)
  actualPrice        Decimal                @map("actual_price") @db.Decimal(12, 2)
  autoRenew          Boolean                @default(false) @map("auto_renew")
  paymentStatus      PaymentStatusEnum      @default(pending) @map("payment_status")
  paymentMethod      PaymentMethodEnum?     @map("payment_method")
  transactionId      String?                @map("transaction_id")
  couponCode         String?                @map("coupon_code")
  discountAmount     Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 2)
  renewalCount       Int                    @default(0) @map("renewal_count")
  lastRenewalDate    DateTime?              @map("last_renewal_date") @db.Timestamptz(6)
  cancelledAt        DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?                @map("cancelled_by") @db.Uuid
  cancellationReason String?                @map("cancellation_reason")
  notes              String?
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeper      User             @relation("SubscriptionShopkeeper", fields: [shopkeeperId], references: [id])
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  cancelledByUser User?            @relation("CancelledBy", fields: [cancelledBy], references: [id])

  @@index([shopkeeperId, createdAt(sort: Desc)], map: "idx_subscriptions_shopkeeper_created_desc")
  @@index([status, endDate], map: "idx_subscriptions_status_end_date")
  @@index([planId, status], map: "idx_subscriptions_plan_status")
  @@index([createdAt(sort: Desc)], map: "idx_subscriptions_created_desc")
  @@index([updatedAt(sort: Desc)], map: "idx_subscriptions_updated_desc")
  @@map("subscriptions")
}

model Coupon {
  id            String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code          String           @unique
  discountType  DiscountTypeEnum @map("discount_type")
  discountValue Decimal          @map("discount_value") @db.Decimal(12, 2)
  agentId       String           @map("agent_id") @db.Uuid
  description   String?
  expiryDate    DateTime?        @map("expiry_date") @db.Timestamptz(6)
  maxUses       Int?             @map("max_uses")
  currentUses   Int              @default(0) @map("current_uses")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent User @relation("CouponAgent", fields: [agentId], references: [id])

  @@index([agentId, createdAt(sort: Desc)], map: "idx_coupons_agent_created_desc")
  @@index([isActive, createdAt(sort: Desc)], map: "idx_coupons_active_created_desc")
  @@map("coupons")
}

model OnboardingStatus {
  id                       String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  businessProfileCompleted Boolean   @default(false) @map("business_profile_completed")
  termsAccepted            Boolean   @default(false) @map("terms_accepted")
  termsAcceptedAt          DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  subscriptionActivated    Boolean   @default(false) @map("subscription_activated")
  onboardingCompleted      Boolean   @default(false) @map("onboarding_completed")
  currentStep              Int       @default(1) @map("current_step")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([currentStep], map: "idx_onboarding_statuses_current_step")
  @@map("onboarding_statuses")
}

model Otp {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  phone     String
  otp       String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phone, createdAt(sort: Desc)], map: "idx_otps_phone_created_desc")
  @@index([expiresAt], map: "idx_otps_expires_at")
  @@map("otps")
}

model AuditLog {
  id             String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminId        String          @map("admin_id") @db.Uuid
  adminRole      RoleEnum        @map("admin_role")
  action         AuditActionEnum
  targetUserId   String?         @map("target_user_id") @db.Uuid
  targetUserRole RoleEnum?       @map("target_user_role")
  details        Json            @default("{}")
  ipAddress      String?         @map("ip_address")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  admin      User  @relation("AuditAdmin", fields: [adminId], references: [id])
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([adminId, createdAt(sort: Desc)], map: "idx_audit_logs_admin_created_desc")
  @@index([targetUserId, createdAt(sort: Desc)], map: "idx_audit_logs_target_created_desc")
  @@index([action, createdAt(sort: Desc)], map: "idx_audit_logs_action_created_desc")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_desc")
  @@map("audit_logs")
}
