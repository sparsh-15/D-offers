generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleEnum {
  super_admin
  subadmin
  company_sales_agent
  ssa
  shopkeeper
  customer

  @@map("role_enum")
}

enum ApprovalStatusEnum {
  pending
  approved
  rejected

  @@map("approval_status_enum")
}

enum OfferStatusEnum {
  active
  inactive
  expired

  @@map("offer_status_enum")
}

enum DiscountTypeEnum {
  percentage
  fixed

  @@map("discount_type_enum")
}

enum SubscriptionStatusEnum {
  active
  inactive
  expired
  cancelled
  pending

  @@map("subscription_status_enum")
}

enum PaymentStatusEnum {
  pending
  paid
  failed
  refunded

  @@map("payment_status_enum")
}

enum PaymentMethodEnum {
  cash
  upi
  card
  netbanking
  other

  @@map("payment_method_enum")
}

enum CampaignStatusEnum {
  draft
  pending_payment
  paid
  queued
  sending
  completed
  cancelled
  failed

  @@map("campaign_status_enum")
}

enum DeliveryStatusEnum {
  pending
  sent
  delivered
  opened
  clicked
  failed

  @@map("delivery_status_enum")
}

enum AuditActionEnum {
  user_activated
  user_deactivated
  user_approved
  user_rejected
  subscription_created
  subscription_updated
  subscription_cancelled
  subscription_renewed
  subscription_plan_created
  subscription_plan_updated
  subscription_plan_deleted
  shop_approved
  shop_rejected
  coupon_activated
  agent_assigned
  lead_created
  lead_linked_existing_user
  lead_invite_sent
  lead_invite_failed
  lead_conflict_rejected

  @@map("audit_action_enum")
}

enum CallbackStatusEnum {
  pending
  completed
  cancelled

  @@map("callback_status_enum")
}

model AppSetting {
  id    String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key   String @unique
  value String
  @@map("app_settings")
}

model User {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name           String             @default("")
  email          String?
  phone          String             @unique
  password       String?
  role           RoleEnum
  pincode        String             @default("")
  city           String             @default("")
  state          String             @default("")
  region         String             @default("")
  territory      String             @default("")
  address        String             @default("")
  gender         String?            @map("gender")
  dob            DateTime?          @map("dob") @db.Timestamptz(6)
  occupation     String?            @map("occupation")
  aboutMe        String?            @map("about_me")
  shopRegistrationNumber String?    @map("shop_registration_number")
  gstNumber      String?            @map("gst_number")
  electricityConsumerNumber String? @map("electricity_consumer_number")
  aadhaarNumber  String?            @map("aadhaar_number")
  panNumber      String?            @map("pan_number")
  maxCouponDiscountPercent Int      @default(50) @map("max_coupon_discount_percent")
  approvalStatus ApprovalStatusEnum @default(approved) @map("approval_status")
  permissions    String[]           @default([])
  isActive       Boolean            @default(true) @map("is_active")
  signupCouponCode       String?    @map("signup_coupon_code")
  signupCouponCapturedAt DateTime?  @map("signup_coupon_captured_at") @db.Timestamptz(6)
  onboardedByLeadId      String?    @map("onboarded_by_lead_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeperProfile      ShopkeeperProfile?
  onboardedShops         ShopkeeperProfile[]            @relation("OnboardedBy")
  offers                 Offer[]                        @relation("OfferShopkeeper")
  offerLikes             OfferLike[]
  subscriptions          Subscription[]                 @relation("SubscriptionShopkeeper")
  cancelledSubscriptions Subscription[]                 @relation("CancelledBy")
  agentCoupons           Coupon[]                       @relation("CouponAgent")
  onboardingStatus       OnboardingStatus?
  adminAuditLogs         AuditLog[]                     @relation("AuditAdmin")
  targetAuditLogs        AuditLog[]                     @relation("AuditTarget")
  planPriceChanges       SubscriptionPlanPriceHistory[] @relation("PriceChangedBy")
  aiWallet               AiWallet?
  aiCreditPurchases      AiCreditPurchase[]
  shopLeadsAsSsa         ShopLead[]                     @relation("ShopLeadSsa")
  shopLeadsAsCsa         ShopLead[]                     @relation("ShopLeadCsa")
  shopLeadsAsShopkeeper  ShopLead[]                     @relation("ShopLeadUser")
  loginHistory           LoginHistory[]
  loanApplications       LoanApplication[]
  campaigns              Campaign[]                     @relation("UserCampaigns")
  campaignDeliveries     CampaignDelivery[]             @relation("CustomerDeliveries")
  inboxMessages          InboxMessage[]                 @relation("CustomerInbox")
  sentInboxMessages      InboxMessage[]                 @relation("InboxSender")

  @@index([role, approvalStatus, createdAt(sort: Desc)], map: "idx_users_role_approval_created_desc")
  @@index([role, isActive, createdAt(sort: Desc)], map: "idx_users_role_active_created_desc")
  @@index([pincode], map: "idx_users_pincode")
  @@index([city], map: "idx_users_city")
  @@index([state], map: "idx_users_state")
  @@index([onboardedByLeadId], map: "idx_users_onboarded_by_lead_id")
  @@map("users")
}

model ShopkeeperProfile {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  shopName    String   @map("shop_name")
  address     String?
  pincode     String?
  city        String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  category    String?
  description String?
  shopImages  String[] @default([]) @map("shop_images")
  logoUrl     String?  @map("logo_url")
  onboardedBy String?  @map("onboarded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User  @relation(fields: [userId], references: [id])
  onboardedByUser User? @relation("OnboardedBy", fields: [onboardedBy], references: [id])

  @@index([category], map: "idx_shopkeeper_profiles_category")
  @@index([onboardedBy], map: "idx_shopkeeper_profiles_onboarded_by")
  @@index([pincode], map: "idx_shopkeeper_profiles_pincode")
  @@index([city], map: "idx_shopkeeper_profiles_city")
  @@map("shopkeeper_profiles")
}

model Offer {
  id                 String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shopkeeperId       String           @map("shopkeeper_id") @db.Uuid
  title              String
  description        String?
  photos             String[]         @default([])
  termsAndConditions String?          @map("terms_and_conditions")
  category           String?
  discountType       DiscountTypeEnum @default(percentage) @map("discount_type")
  discountValue      Decimal?         @map("discount_value") @db.Decimal(12, 2)
  validFrom          DateTime?        @map("valid_from") @db.Timestamptz(6)
  validTo            DateTime?        @map("valid_to") @db.Timestamptz(6)
  status             OfferStatusEnum  @default(active)
  likesCount         Int              @default(0) @map("likes_count")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeper User        @relation("OfferShopkeeper", fields: [shopkeeperId], references: [id])
  likes      OfferLike[]
  campaigns  Campaign[]  @relation("OfferCampaigns")

  @@index([shopkeeperId, createdAt(sort: Desc)], map: "idx_offers_shopkeeper_created_desc")
  @@index([status, createdAt(sort: Desc)], map: "idx_offers_status_created_desc")
  @@index([validTo], map: "idx_offers_valid_to")
  @@index([category, createdAt(sort: Desc)], map: "idx_offers_category_created_desc")
  @@map("offers")
}

model OfferLike {
  offerId   String   @map("offer_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([offerId, userId])
  @@index([userId, createdAt(sort: Desc)], map: "idx_offer_likes_user_created_desc")
  @@index([offerId], map: "idx_offer_likes_offer")
  @@map("offer_likes")
}

model Campaign {
  id                    String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shopkeeperId          String             @map("shopkeeper_id") @db.Uuid
  offerId               String?            @map("offer_id") @db.Uuid
  title                 String
  description           String?
  bannerUrl             String?            @map("banner_url")
  bannerType            String             @default("template") @map("banner_type")
  shopCategory          String             @map("shop_category")
  channels              String[]           @default([])
  status                CampaignStatusEnum @default(draft)
  targetCity            String?            @map("target_city")
  targetArea            String?            @map("target_area")
  targetPincode         String?            @map("target_pincode")
  targetState           String?            @map("target_state")
  targetAgeMin          Int?               @map("target_age_min")
  targetAgeMax          Int?               @map("target_age_max")
  targetGender          String?            @map("target_gender")
  estimatedAudience     Int                @default(0) @map("estimated_audience")
  selectedAudienceSize  Int                @default(0) @map("selected_audience_size")
  actualAudienceReached Int                @default(0) @map("actual_audience_reached")
  whatsappUnitPrice     Decimal?           @map("whatsapp_unit_price") @db.Decimal(8, 2)
  inboxUnitPrice        Decimal?           @map("inbox_unit_price") @db.Decimal(8, 2)
  totalCost             Decimal            @map("total_cost") @db.Decimal(12, 2)
  paymentStatus         PaymentStatusEnum  @default(pending) @map("payment_status")
  paymentMethod         PaymentMethodEnum? @map("payment_method")
  transactionId         String?            @map("transaction_id")
  scheduledAt           DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  launchedAt            DateTime?          @map("launched_at") @db.Timestamptz(6)
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeper User               @relation("UserCampaigns", fields: [shopkeeperId], references: [id], onDelete: Cascade)
  offer      Offer?             @relation("OfferCampaigns", fields: [offerId], references: [id], onDelete: SetNull)
  deliveries CampaignDelivery[]
  inboxMessages InboxMessage[]

  @@index([shopkeeperId, status], map: "idx_campaigns_shopkeeper_status")
  @@index([shopkeeperId, createdAt(sort: Desc)], map: "idx_campaigns_shopkeeper_created_desc")
  @@index([status, scheduledAt], map: "idx_campaigns_status_scheduled_at")
  @@map("campaigns")
}

model CampaignDelivery {
  id           String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  campaignId   String             @map("campaign_id") @db.Uuid
  customerId   String             @map("customer_id") @db.Uuid
  channel      String
  status       DeliveryStatusEnum @default(pending)
  sentAt       DateTime?          @map("sent_at") @db.Timestamptz(6)
  deliveredAt  DateTime?          @map("delivered_at") @db.Timestamptz(6)
  openedAt     DateTime?          @map("opened_at") @db.Timestamptz(6)
  clickedAt    DateTime?          @map("clicked_at") @db.Timestamptz(6)
  errorMessage String?            @map("error_message")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer User     @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId, channel], map: "uniq_campaign_delivery_channel")
  @@index([campaignId, status], map: "idx_campaign_deliveries_campaign_status")
  @@index([customerId, createdAt(sort: Desc)], map: "idx_campaign_deliveries_customer_created_desc")
  @@map("campaign_deliveries")
}

model InboxMessage {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  campaignId  String?   @map("campaign_id") @db.Uuid
  shopkeeperId String?  @map("shopkeeper_id") @db.Uuid
  title       String
  body        String
  bannerUrl   String?   @map("banner_url")
  offerId     String?   @map("offer_id") @db.Uuid
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer   User      @relation("CustomerInbox", fields: [customerId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  shopkeeper User?     @relation("InboxSender", fields: [shopkeeperId], references: [id], onDelete: SetNull)

  @@index([customerId, isRead, createdAt(sort: Desc)], map: "idx_inbox_messages_customer_read_created_desc")
  @@index([campaignId], map: "idx_inbox_messages_campaign_id")
  @@map("inbox_messages")
}

model CampaignTemplate {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String
  category    String
  bannerUrl   String   @map("banner_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([category, isActive], map: "idx_campaign_templates_category_active")
  @@map("campaign_templates")
}

model CampaignPricing {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  channel         String   @unique
  pricePerMessage Decimal  @map("price_per_message") @db.Decimal(8, 2)
  isActive        Boolean  @default(true) @map("is_active")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("campaign_pricing")
}

model SubscriptionPlan {
  id                        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name                      String   @unique
  displayName               String   @map("display_name")
  description               String   @default("")
  monthlyPrice              Decimal  @map("monthly_price") @db.Decimal(12, 2)
  durationDays              Int      @default(30) @map("duration_days")
  category                  String
  features                  String[] @default([])
  maxOffers                 Int      @default(-1) @map("max_offers")
  maxPhotosPerOffer         Int      @default(5) @map("max_photos_per_offer")
  analyticsEnabled          Boolean  @default(false) @map("analytics_enabled")
  prioritySupport           Boolean  @default(false) @map("priority_support")
  isActive                  Boolean  @default(true) @map("is_active")
  sortOrder                 Int      @default(0) @map("sort_order")
  monthlyAiLimit            Int      @default(0) @map("monthly_ai_limit")
  rankingTier               String   @default("normal") @map("ranking_tier")
  homepageRotation         Boolean  @default(false) @map("homepage_rotation")
  aiOptimizationSuggestions Boolean  @default(false) @map("ai_optimization_suggestions")
  aiCreditTier              String   @default("silver") @map("ai_credit_tier")
  tier                      String?  @map("tier")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]
  priceHistory  SubscriptionPlanPriceHistory[]

  @@index([isActive, category, sortOrder, monthlyPrice], map: "idx_subscription_plans_active_category_sort_price")
  @@index([category, isActive], map: "idx_subscription_plans_category_active")
  @@index([category, tier], map: "idx_subscription_plans_category_tier")
  @@map("subscription_plans")
}

model SubscriptionPlanPriceHistory {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  price     Decimal  @db.Decimal(12, 2)
  changedBy String?  @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  reason    String?

  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  changedByUser User?            @relation("PriceChangedBy", fields: [changedBy], references: [id])

  @@index([planId, changedAt(sort: Desc)], map: "idx_plan_price_history_plan_changed_desc")
  @@map("subscription_plan_price_history")
}

model Subscription {
  id                 String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shopkeeperId       String                 @map("shopkeeper_id") @db.Uuid
  planId             String                 @map("plan_id") @db.Uuid
  planSnapshot       Json                   @map("plan_snapshot")
  status             SubscriptionStatusEnum @default(pending)
  startDate          DateTime?              @map("start_date") @db.Timestamptz(6)
  endDate            DateTime?              @map("end_date") @db.Timestamptz(6)
  actualPrice        Decimal                @map("actual_price") @db.Decimal(12, 2)
  autoRenew          Boolean                @default(false) @map("auto_renew")
  paymentStatus      PaymentStatusEnum      @default(pending) @map("payment_status")
  paymentMethod      PaymentMethodEnum?     @map("payment_method")
  transactionId      String?                @map("transaction_id")
  couponCode         String?                @map("coupon_code")
  discountAmount     Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 2)
  couponAgentIdSnapshot   String?           @map("coupon_agent_id_snapshot") @db.Uuid
  couponAgentNameSnapshot String?           @map("coupon_agent_name_snapshot")
  couponAgentRoleSnapshot String?           @map("coupon_agent_role_snapshot")
  couponCampaignSnapshot Json?             @map("coupon_campaign_snapshot")
  renewalCount       Int                    @default(0) @map("renewal_count")
  lastRenewalDate    DateTime?              @map("last_renewal_date") @db.Timestamptz(6)
  cancelledAt        DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?                @map("cancelled_by") @db.Uuid
  cancellationReason String?                @map("cancellation_reason")
  notes              String?
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeper         User               @relation("SubscriptionShopkeeper", fields: [shopkeeperId], references: [id])
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  cancelledByUser    User?              @relation("CancelledBy", fields: [cancelledBy], references: [id])
  aiWallets          AiWallet[]
  aiCreditPurchases  AiCreditPurchase[]

  @@index([shopkeeperId, createdAt(sort: Desc)], map: "idx_subscriptions_shopkeeper_created_desc")
  @@index([status, endDate], map: "idx_subscriptions_status_end_date")
  @@index([planId, status], map: "idx_subscriptions_plan_status")
  @@index([createdAt(sort: Desc)], map: "idx_subscriptions_created_desc")
  @@index([updatedAt(sort: Desc)], map: "idx_subscriptions_updated_desc")
  @@map("subscriptions")
}

model Coupon {
  id            String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code          String           @unique
  discountType  DiscountTypeEnum @map("discount_type")
  discountValue Decimal          @map("discount_value") @db.Decimal(12, 2)
  agentId       String           @map("agent_id") @db.Uuid
  description   String?
  expiryDate    DateTime?        @map("expiry_date") @db.Timestamptz(6)
  maxUses       Int?             @map("max_uses")
  currentUses   Int              @default(0) @map("current_uses")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent User @relation("CouponAgent", fields: [agentId], references: [id])

  @@index([agentId, createdAt(sort: Desc)], map: "idx_coupons_agent_created_desc")
  @@index([isActive, createdAt(sort: Desc)], map: "idx_coupons_active_created_desc")
  @@map("coupons")
}

model OnboardingStatus {
  id                       String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  businessProfileCompleted Boolean   @default(false) @map("business_profile_completed")
  termsAccepted            Boolean   @default(false) @map("terms_accepted")
  termsAcceptedAt          DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  subscriptionActivated    Boolean   @default(false) @map("subscription_activated")
  onboardingCompleted      Boolean   @default(false) @map("onboarding_completed")
  currentStep              Int       @default(1) @map("current_step")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([currentStep], map: "idx_onboarding_statuses_current_step")
  @@map("onboarding_statuses")
}

model Otp {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  phone     String
  otp       String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phone, createdAt(sort: Desc)], map: "idx_otps_phone_created_desc")
  @@index([expiresAt], map: "idx_otps_expires_at")
  @@map("otps")
}

model AuditLog {
  id             String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminId        String          @map("admin_id") @db.Uuid
  adminRole      RoleEnum        @map("admin_role")
  action         AuditActionEnum
  targetUserId   String?         @map("target_user_id") @db.Uuid
  targetUserRole RoleEnum?       @map("target_user_role")
  details        Json            @default("{}")
  ipAddress      String?         @map("ip_address")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  admin      User  @relation("AuditAdmin", fields: [adminId], references: [id])
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([adminId, createdAt(sort: Desc)], map: "idx_audit_logs_admin_created_desc")
  @@index([targetUserId, createdAt(sort: Desc)], map: "idx_audit_logs_target_created_desc")
  @@index([action, createdAt(sort: Desc)], map: "idx_audit_logs_action_created_desc")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_desc")
  @@map("audit_logs")
}

model LoginHistory {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       RoleEnum
  phone      String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  loggedInAt DateTime @default(now()) @map("logged_in_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, loggedInAt(sort: Desc)], map: "idx_login_history_user_logged_in_desc")
  @@map("login_history")
}

model AiWallet {
  id                       String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shopkeeperId             String    @unique @map("shopkeeper_id") @db.Uuid
  subscriptionId           String?   @map("subscription_id") @db.Uuid
  cycleStart               DateTime? @map("cycle_start") @db.Timestamptz(6)
  cycleEnd                 DateTime? @map("cycle_end") @db.Timestamptz(6)
  monthlyLimit             Int       @default(0) @map("monthly_limit")
  usedThisCycle            Int       @default(0) @map("used_this_cycle")
  extraCreditsCurrentCycle Int       @default(0) @map("extra_credits_current_cycle")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopkeeper   User          @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([subscriptionId], map: "idx_ai_wallet_subscription_id")
  @@map("ai_wallet")
}

model AiCreditPurchase {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shopkeeperId   String   @map("shopkeeper_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  packSku        String   @map("pack_sku")
  credits        Int
  price          Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shopkeeper   User         @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([shopkeeperId, createdAt(sort: Desc)], map: "idx_ai_credit_purchases_shopkeeper_created_desc")
  @@index([subscriptionId], map: "idx_ai_credit_purchases_subscription_id")
  @@map("ai_credit_purchases")
}

model AiCreditPack {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sku           String   @unique
  displayName   String   @map("display_name")
  category      String   @default("all") @db.Text
  credits       Int
  priceSilver   Decimal  @map("price_silver") @db.Decimal(12, 2)
  priceGold     Decimal  @map("price_gold") @db.Decimal(12, 2)
  pricePlatinum Decimal  @map("price_platinum") @db.Decimal(12, 2)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@map("ai_credit_packs")
}

model CallbackRequest {
  id          String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  offerId     String             @map("offer_id") @db.Uuid
  customerId  String             @map("customer_id") @db.Uuid
  message     String?            @db.Text
  status      CallbackStatusEnum @default(pending)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([offerId, createdAt(sort: Desc)], map: "idx_callback_requests_offer_created_desc")
  @@index([customerId, createdAt(sort: Desc)], map: "idx_callback_requests_customer_created_desc")
  @@map("callback_requests")
}

model ShopLead {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ssaId      String?  @map("ssa_id") @db.Uuid
  csaId      String?  @map("csa_id") @db.Uuid
  shopkeeperUserId String? @map("shopkeeper_user_id") @db.Uuid
  shopName   String   @map("shop_name")
  ownerName  String?  @map("owner_name")
  phone      String
  pincode    String?
  city       String?
  category   String?
  notes      String?
  couponCode String?  @map("coupon_code")
  sourceAgentRole RoleEnum? @map("source_agent_role")
  claimedAt  DateTime? @map("claimed_at") @db.Timestamptz(6)
  inviteStatus String @default("pending") @map("invite_status")
  inviteSentAt DateTime? @map("invite_sent_at") @db.Timestamptz(6)
  inviteError String? @map("invite_error")
  status     String   @default("open")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ssa User? @relation("ShopLeadSsa", fields: [ssaId], references: [id])
  csa User? @relation("ShopLeadCsa", fields: [csaId], references: [id])
  shopkeeperUser User? @relation("ShopLeadUser", fields: [shopkeeperUserId], references: [id])

  @@index([ssaId, status], map: "idx_shop_leads_ssa_status")
  @@index([csaId, status], map: "idx_shop_leads_csa_status")
  @@index([shopkeeperUserId], map: "idx_shop_leads_shopkeeper_user_id")
  @@index([couponCode], map: "idx_shop_leads_coupon_code")
  @@map("shop_leads")
}

model LoanApplication {
  id                      String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId              String   @map("customer_id") @db.Uuid
  fullName                String   @map("full_name")
  mobileNumber            String   @map("mobile_number")
  employmentType          String   @map("employment_type")
  monthlySalaryIncome     Decimal  @map("monthly_salary_income") @db.Decimal(14, 2)
  loanAmount              Decimal  @map("loan_amount") @db.Decimal(14, 2)
  panNumber               String   @map("pan_number")
  bankName                String   @map("bank_name")
  accountType             String   @map("account_type")
  last4AccountDigits      String   @map("last_4_account_digits")
  cibilConsent            Boolean  @default(false) @map("cibil_consent")
  communicationConsent    Boolean  @default(false) @map("communication_consent")
  status                  String   @default("pending")
  cibilScore              Int?     @map("cibil_score")
  eligibilityStatus       String?  @map("eligibility_status")
  evaluatedAt             DateTime? @map("evaluated_at") @db.Timestamptz(6)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt(sort: Desc)], map: "idx_loan_applications_customer_created_desc")
  @@index([status], map: "idx_loan_applications_status")
  @@map("loan_applications")
}


